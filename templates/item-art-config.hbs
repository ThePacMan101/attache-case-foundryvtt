<div class="attache-config-body">
  <div class="attache-art-head">
    <div class="attache-art-preview">
      <img src="{{preview.src}}" data-fallback="{{preview.fallback}}" alt="" draggable="false">
    </div>
    <p class="hint">{{localize "ATTACHE.Config.ArtHint"}}</p>
  </div>
  <div class="form-group">
    <label for="{{rootId}}-art">{{localize "ATTACHE.Config.ArtPath"}}</label>
    <div class="form-fields">
      <file-picker id="{{rootId}}-art" name="art" type="image" value="{{path}}"></file-picker>
    </div>
  </div>
  <button type="button" class="attache-reset" data-action="resetArt">
    <i class="fa-solid fa-arrow-rotate-left" aria-hidden="true"></i> {{localize "ATTACHE.Config.Reset"}}
  </button>
</div>
