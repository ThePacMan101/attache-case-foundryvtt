# Copy to .env and fill ONE of the two options. .env is gitignored.
# Plain KEY=value lines only (no quotes, no spaces around "="). Never commit real values.
# Option A: your foundryvtt.com account (the container downloads Foundry v14 and fetches your license key)
FOUNDRY_USERNAME=
FOUNDRY_PASSWORD=
# Option B: a timed download URL (foundryvtt.com > Purchased Licenses > Linux/NodeJS > "Timed URL")
FOUNDRY_RELEASE_URL=
# Optional: license key to apply (format AAAA-BBBB-...). Without it, option A fetches it from the account.
FOUNDRY_LICENSE_KEY=
# Admin password for the local test server
FOUNDRY_ADMIN_KEY=attache-dev
