{
  "id": "attache-case",
  "title": "Attaché Case",
  "description": "A Resident Evil 4 style briefcase inventory for Call of Cthulhu 7th Edition and Delta Green. Every physical item takes a number of grid cells; players drag, drop and rotate items to pack them into their pockets and containers, armor can be worn, and whatever does not fit waits in an Unstowed tray. The GM sets item sizes, each actor's grid and their backpacks and cases, with sensible default sizes for the systems' compendium items and a set of ready-made containers.",
  "version": "1.0.0",
  "authors": [{ "name": "Lucas Pimentel" }],
  "compatibility": {
    "minimum": "14.359",
    "verified": "14.369"
  },
  "esmodules": ["scripts/main.mjs"],
  "styles": ["styles/attache-case.css"],
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" },
    { "lang": "pt-BR", "name": "Português (Brasil)", "path": "lang/pt-BR.json" }
  ],
  "relationships": {
    "systems": [
      { "id": "CoC7", "type": "system", "compatibility": { "verified": "8.16" } },
      { "id": "deltagreen", "type": "system", "compatibility": {} }
    ]
  },
  "packs": [
    {
      "name": "containers-coc7",
      "label": "Attaché Case: Containers",
      "system": "CoC7",
      "path": "packs/containers-coc7",
      "type": "Item",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" },
      "flags": {}
    },
    {
      "name": "containers-deltagreen",
      "label": "Attaché Case: Containers",
      "system": "deltagreen",
      "path": "packs/containers-deltagreen",
      "type": "Item",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" },
      "flags": {}
    }
  ],
  "packFolders": [
    {
      "name": "Attaché Case",
      "sorting": "a",
      "color": "#3a3f4a",
      "packs": ["containers-coc7", "containers-deltagreen"]
    }
  ],
  "socket": false,
  "url": "https://github.com/OWNER/attache-case",
  "manifest": "https://github.com/OWNER/attache-case/releases/latest/download/module.json",
  "download": "https://github.com/OWNER/attache-case/releases/download/v1.0.0/module.zip",
  "readme": "https://github.com/OWNER/attache-case/blob/main/README.md",
  "bugs": "https://github.com/OWNER/attache-case/issues",
  "license": "LICENSE",
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"],
      "paths": ["styles", "templates", "lang"]
    }
  }
}
